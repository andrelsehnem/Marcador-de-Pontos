{
  "name": "marcador-de-baralho",
  "version": "2.0.25",
  "description": "Acompanhe suas mãos e jogadas",
  "scripts": {
    "dev": "expo start",
    "startClear": "expo start --clear",
    "web": "expo start --web",
    "build:web": "expo export -p web && node scripts/sync-head.js && node scripts/inject-adsense.js && node scripts/generate-seo-files.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:store": "cd android && gradlew.bat bundleRelease",
    "playStore": "call \"Build Android.bat\""
  },
  "pnpm": {
    "shamefullyHoist": true
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@vercel/analytics": "^1.6.1",
    "expo": "~56.0.11",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-navigation-bar": "~56.0.3",
    "expo-router": "~56.2.10",
    "expo-screen-orientation": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "lucide-react": "^0.563.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-google-mobile-ads": "^16.2.1",
    "react-native-iap": "^14.5.0",
    "react-native-nitro-modules": "^0.31.10",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "hermes-compiler": "^250829098.0.2",
    "typescript": "^6.0.3"
  }
}
